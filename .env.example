# Lottery-only (no bingo process needed)
# From this folder:  npm run dev
# Open: http://127.0.0.1:3010/lottery
# Staff: http://127.0.0.1:3010/lottery/manage

# Do not load ../.env (bingo). Set to yes only if you want to reuse bingo DB_* secrets.
LOTTERY_INHERIT_PARENT_ENV=no

LOTTERY_PORT=3010
LOTTERY_HOST=127.0.0.1
LOTTERY_BASE_PATH=/lottery

LOTTERY_DB_HOST=localhost
LOTTERY_DB_PORT=3306
LOTTERY_DB_USER=root
LOTTERY_DB_PASSWORD=your-mysql-password
LOTTERY_DB_NAME=maraki_ekub

LOTTERY_SESSION_SECRET=replace-with-a-long-random-string
LOTTERY_ADMIN_USERNAME=lotteryadmin
LOTTERY_ADMIN_PASSWORD=change-me-lottery-admin

# Optional public URL (Telegram deep links)
# LOTTERY_APP_URL=https://your-domain.com/lottery

# Optional dedicated lottery bot (different token from bingo)
# LOTTERY_TELEGRAM_BOT_TOKEN=
# LOTTERY_TELEGRAM_BOT_USERNAME=
# LOTTERY_TELEGRAM_CLIENT_ID=

# Browser "Sign in with Telegram" needs BotFather → your bot → Login Widget
# Allowed URLs (exact). Add both:
#   https://your-domain.com
#   https://your-domain.com/lottery/
# Missing these → Telegram error: redirect_uri required
