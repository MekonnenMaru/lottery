# App
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
APP_NAME=Maraki Ekub
APP_URL=https://equb.ethiomark.com
# The server clock is Africa/Nairobi (UTC+3) for every deadline, report, and countdown.

# Staff sign-in. Use a long random SESSION_SECRET and a password that is not "admin".
SESSION_SECRET=replace-with-a-long-random-string
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-staff-password

# Database. DB_HOST is the database server, not the website.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your-mysql-password
DB_NAME=maraki_ekub

# Telegram. CLIENT_ID is the number from BotFather, Login Widget.
# If CLIENT_ID is empty, the number before the colon in TELEGRAM_BOT_TOKEN is used.
TELEGRAM_CLIENT_ID=
TELEGRAM_BOT_USERNAME=
TELEGRAM_BOT_TOKEN=
